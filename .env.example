# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.
PORT=8080

# Cadena de conexión de MongoDB Atlas (use una contraseña NUEVA, la anterior quedó expuesta).
# El nombre de la base va después del clúster:
#   - filtramos      -> SOLO el entorno desplegado (producción). Nunca en el .env de un equipo local.
#   - filtramos_dev  -> desarrollo local (mismo clúster).
#   - *_test         -> pruebas automáticas.
# Los scripts que escriben (indices --aplicar, seed:demo, crear-admin, migrar:b --aplicar,
# indice-referencia) muestran la base y piden escribir su nombre si no termina en _dev o _test.
# En un entorno sin terminal se confirma con CONFIRMAR_BASE=<nombre exacto de la base>.
MONGO_DBCNN=mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER/filtramos_dev

# Clave para firmar los tokens de sesión. Genere una larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS, separados por coma (panel y sitio público)
CORS_ORIGINS=http://localhost:4200

# URL pública de esta API (se usa para armar enlaces de imágenes)
PUBLIC_URL=http://localhost:8080

# Solo para el script crear-admin
ADMIN_NOMBRE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Almacenamiento de imágenes: local (disco) por ahora; cloudinary en la etapa E
ALMACENAMIENTO=local
# Opcional: carpeta de imágenes locales (por defecto public/uploads)
# UPLOADS_DIR=

# Solo desarrollo local: permite npm run seed:demo contra la base del .env
# PERMITIR_DEMO=1

# Formularios públicos permitidos por IP y por hora (por defecto 10)
# LIMITE_FORMULARIOS_HORA=10
