# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.
PORT=8080

# Cadena de conexión de MongoDB Atlas (use una contraseña NUEVA, la anterior quedó expuesta)
MONGO_DBCNN=mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER/filtramos

# Clave para firmar los tokens de sesión. Genere una larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS, separados por coma (panel y sitio público)
CORS_ORIGINS=http://localhost:4200

# URL pública de esta API (se usa para armar enlaces de imágenes)
PUBLIC_URL=http://localhost:8080

# Solo para el script crear-admin
ADMIN_NOMBRE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
